# Direct connection: used for running migrations.
DATABASE_URL=
# Pooled connection: used by the FastAPI backend.
DATABASE_URL_POOLED=
# Comma-separated list of frontend origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8443

# Signs login tokens. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=

# Gemini API key from https://aistudio.google.com/apikey. Used by /llm/chat for chirps and ideas.
GEMINI_API_KEY=
# Which Gemini model to use.
GEMINI_MODEL=gemini-3.5-flash-lite